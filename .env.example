# ===================================================
# AetherNexus Prime v4 — Environment Configuration
# ===================================================
# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit API keys.

# --- Default LLM Provider ---
# Options: openai, deepseek, openrouter, local, opencode
DEFAULT_LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_BASE_URL=https://api.openai.com/v1

# --- DeepSeek ---
DEEPSEEK_API_KEY=your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat

# --- OpenRouter (200+ models via single API) ---
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# --- Local Models (Ollama / LM Studio / llama.cpp) ---
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2:1b

# --- OpenCode CLI ---
OPENCODE_MODEL=opencode/hy3-preview-free

# --- Per-Agent Provider Routing (optional) ---
# Route critique agents to different LLMs
# DESIGNER_PROVIDER=openai
# ENGINEER_PROVIDER=deepseek
# ADVOCATE_PROVIDER=local
