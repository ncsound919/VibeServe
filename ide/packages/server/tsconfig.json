{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022"],
		"skipLibCheck": true,
		"isolatedModules": true,
		"strict": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"paths": {
			"@nexus/shared": ["../../src/types/index.ts"]
		},
		"types": ["node"]
	},
	"include": ["../../src/server/**/*.ts", "../../src/types/**/*.ts"],
	"exclude": ["node_modules"]
}
