# ============================================================
# VibeServe — Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored and never committed.
# ============================================================

# --- Pick ONE or more LLM providers ---
# OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# DEEPSEEK_API_KEY=sk-your-key-here
# OPENROUTER_API_KEY=sk-or-your-key-here
# XAI_API_KEY=sk-your-key-here
# OPENCODE_API_KEY=sk-your-key-here
# GEMINI_API_KEY=your-key-here
# OPENCODE_BASE_URL=https://api.opencode.ai/v1
# VITE_OPENCODE_API_KEY=sk-your-key-here

# --- Per-lane LLM provider & model overrides ---
# LLM_DEFAULT_PROVIDER=opencode
# LLM_DEFAULT_MODEL=deepseek-v4-pro
# LLM_CODING_PROVIDER=opencode
# LLM_CODING_MODEL=deepseek-v4-pro
# LLM_CROSS_DOMAIN_PROVIDER=opencode
# LLM_CROSS_DOMAIN_MODEL=deepseek-v4-pro
# LLM_AGENT_BRAIN_PROVIDER=opencode
# LLM_AGENT_BRAIN_MODEL=deepseek-v4-pro
# LLM_TOOL_CALLING_PROVIDER=opencode
# LLM_TOOL_CALLING_MODEL=deepseek-v4-pro
# LLM_BUSINESS_LOGIC_PROVIDER=opencode
# LLM_BUSINESS_LOGIC_MODEL=deepseek-v4-pro
# ROUTER_MODEL=opencode/deepseek-v4-pro

# --- GitHub Token (enables real repo data) ---
# GITHUB_TOKEN=ghp_your-token-here

# --- Persistent auth/sessions ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=eyJ-your-anon-key
# SUPABASE_KEY=eyJ-your-service-role-key
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ-your-anon-key

# --- Server ports (defaults work for dev) ---
# PORT=3002

# --- Redis (optional — BullMQ falls back to simulated pipeline) ---
# REDIS_URL=redis://localhost:6379

# --- GNews ---
# GNEWS_API_KEY=your-key-here

# --- Auth & Security (dev mode) ---
# NEXUS_AUTH_BYPASS=true
# VITE_NEXUS_AUTH_BYPASS=true
# NEXUS_ALLOW_UNSANDBOXED=true

# --- MCP Integrations (optional) ---
# NANOBOT_URL=http://localhost:3030
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# FIRECRAWL_API_KEY=
# TAVILY_API_KEY=
# MEM0_API_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
