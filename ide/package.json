{
	"name": "vibeserve-ide",
	"private": true,
	"version": "2.0.0",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "vite --port=3000 --host=0.0.0.0",
		"dev:all": "concurrently -k -n \"vite,api\" -c \"cyan,green\" \"npm run dev\" \"npm run server\"",
		"start": "npm run dev:all",
		"build": "vite build",
		"preview": "vite preview",
		"electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:3000 && electron .\"",
		"electron:build": "tsc --project electron/tsconfig.json && npm run build && electron-builder",
		"clean": "rm -rf dist",
		"lint": "biome check . && tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "npx tsx --test \"tests/unit/guardrailsService.test.ts\" \"tests/unit/codingAgentService.test.ts\"",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"ci": "npm run typecheck && npm run build && npm run test",
		"server": "tsx src/server/hono.ts",
		"mcp": "tsx src/server/mcp.ts",
		"infra": "tsx src/services/local-infra.ts"
	},
	"dependencies": {
		"@google/genai": "^2.7.0",
		"@hono/node-server": "^2.0.1",
		"@modelcontextprotocol/sdk": "^1.0.0",
		"@monaco-editor/react": "^4.7.0",
		"@supabase/postgrest-js": "^2.105.1",
		"@supabase/supabase-js": "^2.105.1",
		"@tanstack/react-query": "^5.100.6",
		"bullmq": "^5.77.7",
		"clsx": "^2.1.1",
		"dotenv": "^17.2.3",
		"hono": "^4.12.16",
		"hono-rate-limiter": "^0.5.3",
		"ioredis": "^5.11.0",
		"lucide-react": "^0.546.0",
		"monaco-vim": "^0.4.4",
		"motion": "^12.23.24",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-hook-form": "^7.74.0",
		"react-is": "^19.2.5",
		"react-router-dom": "^7.14.2",
		"recharts": "^3.8.1",
		"tailwind-merge": "^3.5.0",
		"uuid": "^14.0.0",
		"ws": "^8.18.0",
		"xterm": "^5.3.0",
		"xterm-addon-fit": "^0.8.0",
		"y-indexeddb": "^9.0.12",
		"y-websocket": "^3.0.0",
		"yjs": "^13.6.30",
		"zod": "^4.4.1",
		"zustand": "^5.0.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.3",
		"@biomejs/biome": "^2.4.13",
		"@playwright/test": "^1.60.0",
		"@tailwindcss/vite": "^4.1.14",
		"@types/node": "^22.0.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/ws": "^8.5.10",
		"@vitejs/plugin-react": "^5.0.4",
		"autoprefixer": "^10.4.21",
		"concurrently": "^9.2.1",
		"electron": "^41.4.0",
		"electron-builder": "^26.8.1",
		"knip": "^6.9.0",
		"tailwindcss": "^4.1.14",
		"tsx": "^4.21.0",
		"typescript": "^5.5.0",
		"vite": "^6.2.0",
		"vite-plugin-node-polyfills": "^0.26.0"
	},
	"build": {
		"appId": "com.vibeserve.ide",
		"productName": "VibeServe",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*"
		],
		"mac": {
			"target": "dmg",
			"icon": "public/icon.png"
		},
		"linux": {
			"target": "AppImage",
			"icon": "public/icon.png"
		},
		"win": {
			"target": "nsis",
			"icon": "public/icon.png"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true
		}
	}
}
