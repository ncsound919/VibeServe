{
  "name": "vibeserve-ts-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript-native Hono HTTP bridge for VibeServe MCP server (Windows-compatible alternative to Python HTTP bridge)",
  "engines": { "node": ">=18.0.0" },
